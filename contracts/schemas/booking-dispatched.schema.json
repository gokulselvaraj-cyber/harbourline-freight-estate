{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.harbourline.example/booking-dispatched.v1.json",
  "title": "booking-dispatched",
  "type": "object",
  "required": [
    "bookingRef",
    "depotCode",
    "slotDate",
    "dockNo",
    "destination",
    "transitDays"
  ],
  "properties": {
    "bookingRef": {
      "type": "string"
    },
    "depotCode": {
      "type": "string"
    },
    "slotDate": {
      "type": "string"
    },
    "dockNo": {
      "type": "integer"
    },
    "destination": {
      "type": "string"
    },
    "transitDays": {
      "type": "integer"
    }
  }
}
