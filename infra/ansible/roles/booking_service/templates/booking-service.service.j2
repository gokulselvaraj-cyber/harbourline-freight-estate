[Unit]
Description=Harbourline booking-service
After=network-online.target

[Service]
User={{ app_user }}
EnvironmentFile=/etc/harbourline/booking-service.env
WorkingDirectory={{ app_root }}/booking-service
ExecStart={{ booking_service_exec }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
